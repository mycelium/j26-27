[
  {
    "label": "Java: compile current file",
    "command": "mkdir -p /tmp/j26-java && javac --release 21 -d /tmp/j26-java \"$(dirname \"$ZED_FILE\")\"/*.java",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Java: run current file in Ghostty",
    "command": "osascript \"$ZED_WORKTREE_ROOT/.zed/run-java.applescript\" \"$ZED_FILE\" \"$ZED_STEM\" \"$ZED_WORKTREE_ROOT\"",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "never",
    "hide": "always"
  }
]
